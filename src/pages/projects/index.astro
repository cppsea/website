---
import Layout from '../../layouts/Layout.astro';
import '../../styles/projects.css';

import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
---

<Layout title='Projects - SEA'>
  <main>
    <section class='hero' style='max-width: 1100px;'>
      <div class='delta-in-triangle'>
        <img
          draggable='false'
          src='../../images/odyssey.png'
          alt='odyssey logo'
        />
      </div>
      <div class='content'>
        <h3 class='title'>Odyssey</h3>
        <h1 class='pre-title'>A Journey Through Innovation</h1>
        <p>
          Our program is designed to host projects oriented towards beginners,
          with the purpose of allowing project members to figure out which area
          of interest they want to pursue, such as frontend, backend, machine
          learning, web development, and more. We are committed to providing a
          supportive environment for students to explore their interests and
          develop their skills.
        </p>
        <div class='anchors'>
          <a class='btn-arrow' href='#collection'>
            <span>view collection</span>
            <svg width='10' height='16' viewBox='0 0 10 16'>
              <path
                d='M1.93286 16L9.93286 8L1.93286 0L0.0672302 1.8672L6.20009 8.00006L0.0672302 14.1329L1.93286 16Z'
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
    <section id='collection'>
      <h1 style='text-align: center;'>Explore our ongoing projects:</h1>
      <div class='projects'>
        {
          projects.map((project) => (
            <project class='block'>
              <div class='left'>
                <h1>{project.data.cardTitle}</h1>
                <a target='_self' href={`/projects/${project.data.slug}`}>
                  <span>Learn more</span>
                  <svg
                    fill='currentColor'
                    width='10'
                    height='16'
                    viewBox='0 0 10 16'
                  >
                    <path d='M1.93286 16L9.93286 8L1.93286 0L0.0672302 1.8672L6.20009 8.00006L0.0672302 14.1329L1.93286 16Z' />
                  </svg>
                </a>
              </div>
              <div class='right' />
            </project>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
