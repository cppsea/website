---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../images/hero.png';
import sealImage from '../images/sealdrawing.png';
import Calendar from '../icons/calendar.astro';

import apple from '../images/apple.png';
import meta from '../images/meta.png';
import amazon from '../images/amazon.png';
import microsoft from '../images/microsoft.png';

import noteTexture from '../images/notetexture.png';

import { getCollection } from 'astro:content';
const projects = await getCollection('projects');

import { board, founders } from '../board';

import Member from '../components/Member.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout
  title='Software Engineering Association'
  description='Become part of the largest software engineering community at Cal Poly Pomona.'
>
  <main>
    <section class='relative' id='home'>
      <div
        class='h-[600px] flex items-center justify-center flex-col gap-6 z-0 relative p-6'
      >
        <Image src={sealImage} alt='Seal Drawing' class='size-28' />
        <h1 class='text-5xl md:text-6xl font-serif text-center'>
          <i>Build</i> With Us
        </h1>
        <p class='text-neutral-600 text-center'>
          Cal Poly Pomona&apos;s premier project incubator.
        </p>
        <a
          href='#events'
          class='flex gap-2.5 px-4 py-3.5 rounded-xl items-center bg-sea text-white border border-solid border-neutral-300'
          ><Calendar /> View Upcoming Events</a
        >
      </div>
      <Image
        src={heroImage}
        alt='Hero'
        class='absolute object-cover top-0 left-0 right-0 bottom-0 w-full h-full -z-10'
      />
    </section>
    <section id='about'>
      <div class='flex items-center justify-center flex-col gap-6 p-6'>
        <p class='font-mono text-neutral-600 text-center'>Who</p>
        <h2
          class='text-3xl md:text-4xl text-center md:max-w-[480px] leading-11'
        >
          We are a 🎒 student-led community of 🎨 creatives & 🧑‍💻 developers with
          a passion for <span
            class='underline decoration-sea decoration-wavy underline-offset-4'
            >learning by doing</span
          >.
        </h2>
      </div>
      <div class='py-12'>
        <p class='font-mono text-neutral-600 text-center'>
          Where Our Members Work
        </p>
        <div
          class='md:flex gap-6 md:gap-12 items-center justify-center grid grid-cols-2 place-items-center px-12'
        >
          <Image
            src={apple}
            alt='Apple'
            class='w-full h-full aspect-square md:size-32'
          />
          <Image
            src={meta}
            alt='Meta'
            class='w-full h-full aspect-square md:size-32'
          />
          <Image
            src={amazon}
            alt='Amazon'
            class='w-full h-full aspect-square md:size-32'
          />
          <Image
            src={microsoft}
            alt='Microsoft'
            class='w-full h-full aspect-square md:size-32'
          />
          <p class='col-span-2 text-center'>+ More</p>
        </div>
      </div>
      <div class='flex items-center justify-center flex-col gap-6 p-6'>
        <p class='font-mono text-neutral-600 text-center'>What</p>
        <div class='flex items-center justify-center flex-wrap pt-12'>
          <div class='w-72 h-64 relative drop-shadow-lg -rotate-3'>
            <div
              class='w-full h-full flex items-center justify-center text-center flex-col p-6'
            >
              <span class='text-4xl'>❤️️</span>
              <h3 class='text-4xl mb-2'>Community</h3>
              <p>Meet other students at our socials, snacks included.</p>
            </div>
            <Image
              src={noteTexture}
              alt='Note Texture'
              class='absolute object-cover w-full h-full top-0 left-0 right-0 bottom-0 -z-10'
            />
          </div>
          <div class='w-72 h-64 relative drop-shadow-lg rotate-[8deg]'>
            <div
              class='w-full h-full flex items-center justify-center text-center flex-col p-6'
            >
              <span class='text-4xl'>📁</span>
              <h3 class='text-4xl mb-2'>Projects</h3>
              <p>
                Every semester we host 3-5 student-led projects, from idea to
                execution.
              </p>
            </div>
            <Image
              src={noteTexture}
              alt='Note Texture'
              class='absolute object-cover w-full h-full top-0 left-0 right-0 bottom-0 -z-10'
            />
          </div>
          <div class='w-72 h-64 relative drop-shadow-lg -rotate-[4deg]'>
            <div
              class='w-full h-full flex items-center justify-center text-center flex-col p-6'
            >
              <span class='text-4xl'>🛠️</span>
              <h3 class='text-4xl mb-2'>Workshops</h3>
              <p>
                Get a taste of industry standard and emerging tech at our guided
                workshops.
              </p>
            </div>
            <Image
              src={noteTexture}
              alt='Note Texture'
              class='absolute object-cover w-full h-full top-0 left-0 right-0 bottom-0 -z-10'
            />
          </div>
        </div>
      </div>
    </section>
    <section id='projects' class='py-12'>
      <div class='flex items-center justify-center flex-col gap-6 p-6'>
        <p class='font-mono text-neutral-600 text-center'>Projects</p>
        <div class='md:px-24 lg:px-64 flex flex-col gap-16'>
          {projects.map((project) => <ProjectCard project={project.data} />)}
        </div>
      </div>
    </section>
    <section id='events' class='py-12'>
      <div class='flex items-center justify-center flex-col gap-6 p-6'>
        <p class='font-mono text-neutral-600 text-center'>When</p>
        <iframe
          src='https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=America%2FLos_Angeles&mode=MONTH&showTz=0&showNav=0&showPrint=0&showCalendars=0&src=Y3Bwc2VhMjAyMUBnbWFpbC5jb20&color=%23039be5'
          class='w-full aspect-square md:aspect-auto md:px-24 lg:px-64 md:h-72'
          frameborder='0'
          scrolling='no'></iframe>
      </div>
    </section>
    <section id='board' class='py-12'>
      <div class='flex items-center justify-center flex-col gap-6 p-6'>
        <p class='font-mono text-neutral-600 text-center'>Us</p>
        <h2 class='text-2xl text-center'>Our Board</h2>
        <div class='grid md:grid-cols-2 gap-12 w-full md:max-w-[600px]'>
          {board.map((member) => <Member member={member} />)}
        </div>
        <h2 class='text-2xl text-center mt-24'>Our Founders</h2>
        <div class='grid md:grid-cols-2 gap-12 w-full md:max-w-[600px]'>
          {founders.map((member) => <Member member={member} />)}
        </div>
      </div>
    </section>
  </main>
</Layout>
